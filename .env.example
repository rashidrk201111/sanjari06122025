# ============================================
# Sanjari Prints - Safe Environment Template
# ============================================
# Copy this file to .env and populate with your environment-specific credentials.
# NEVER commit .env with real secrets to GitHub or version control.

# --------------------------------------------
# Frontend Supabase Configuration
# --------------------------------------------
# Public URL of your Supabase project instance
VITE_SUPABASE_URL=

# Public anonymous key for client requests (protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=

# Optional: Local API backend URL override (e.g. http://127.0.0.1:8000)
VITE_API_URL=

# Deployed application base URL (e.g. https://sanjariprint.in)
VITE_APP_URL=

# --------------------------------------------
# Payment Gateways (Client-Side)
# --------------------------------------------
# Razorpay Key ID for client checkout integration
VITE_RAZORPAY_KEY_ID=

# PhonePe Merchant ID for client checkout reference
VITE_PHONEPE_MERCHANT_ID=

# --------------------------------------------
# Backend Core (Django)
# --------------------------------------------
# Secret key for cryptographic signing (Required in production)
DJANGO_SECRET_KEY=

# Node environment indicator ('development' or 'production')
NODE_ENV=production

# --------------------------------------------
# Google Cloud Platform & Deployment Settings
# --------------------------------------------
# Google Cloud Project ID (e.g. sanjari-prints)
GCP_PROJECT_ID=

# Google Cloud Region (e.g. us-central1 or asia-south1)
GCP_REGION=us-central1

# Google Cloud Run Service Name
GCP_SERVICE_NAME=sanjari-prints

# Docker image tag for container builds
DOCKER_IMAGE_TAG=latest
