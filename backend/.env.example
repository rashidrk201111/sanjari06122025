# ============================================
# Sanjari Prints Backend - Safe Environment Template
# ============================================
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit backend/.env with real secrets to GitHub or version control.

# --------------------------------------------
# Django Core Settings
# --------------------------------------------
# Secret key for cryptographic signing (Required for production)
DJANGO_SECRET_KEY=

# Debug mode (Set to False in production)
DEBUG=False

# Comma-separated list of allowed host header values
ALLOWED_HOSTS=localhost,127.0.0.1,sanjariprint.in,www.sanjariprint.in

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# PostgreSQL connection string via Supabase pooler (port 6543)
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --------------------------------------------
# Supabase Backend Credentials
# --------------------------------------------
# Supabase project URL
SUPABASE_URL=

# Supabase public anonymous key (for auth verification)
SUPABASE_ANON_KEY=

# Supabase privileged service role key (for server-side storage uploads)
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for uploaded PDF print documents (default: order-files)
SUPABASE_UPLOAD_BUCKET=order-files

# --------------------------------------------
# PhonePe V2 PG Credentials
# --------------------------------------------
# PhonePe Client ID from PhonePe Developer Settings
PHONEPE_CLIENT_ID=

# PhonePe Client Secret key
PHONEPE_CLIENT_SECRET=

# PhonePe Client Version (default: 1)
PHONEPE_CLIENT_VERSION=1

# PhonePe Sandbox mode (Set to False for live production transactions)
PHONEPE_SANDBOX=False

# --------------------------------------------
# Shiprocket Logistics Integration
# --------------------------------------------
# Toggle Shiprocket automatic shipment creation
SHIPROCKET_ENABLED=True

# Shiprocket registered account email
SHIPROCKET_EMAIL=

# Shiprocket account password
SHIPROCKET_PASSWORD=

# Shiprocket webhook validation secret
SHIPROCKET_WEBHOOK_SECRET=

# Pickup warehouse details
SHIPROCKET_COMPANY_NAME=Sanjari Prints
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PHONE=
SHIPROCKET_ADDRESS=
SHIPROCKET_ADDRESS2=
SHIPROCKET_CITY=Mumbai
SHIPROCKET_STATE=Maharashtra
SHIPROCKET_PINCODE=
SHIPROCKET_COUNTRY=India
SHIPROCKET_AUTO_CREATE=True

# --------------------------------------------
# CORS & CSRF Trusted Origins
# --------------------------------------------
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://sanjariprint.in,https://www.sanjariprint.in,http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://sanjariprint.in,https://www.sanjariprint.in,http://localhost:3000,http://localhost:5173

# --------------------------------------------
# Security Header Settings (Production)
# --------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
