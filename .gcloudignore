# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore.

# Node.js dependencies
node_modules/

# Build outputs
/dist
/build
/.next
/out

# Environment variables
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing
/coverage

# Local development
.cache
.temp
.tmp

# Docker
# Dockerfile
docker-compose*
# .dockerignore

# Git
.git
.gitignore

# IDE specific files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Local development
.local/

# Security
*.pem
*.p12
*.key
*.cer
*.crt
*.pfx

# Python
__pycache__/
*.py[cod]
*$py.class

# Ignore everything in the root except specific files
/*

# Allow specific files in the root
!/src
!/public
!/backend
!.env
!backend/.env
!app.yaml
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!index.html
!README.md
!Dockerfile
!nginx.conf
!cloudbuild.yaml
!.dockerignore